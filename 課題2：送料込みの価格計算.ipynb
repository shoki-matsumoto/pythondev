     "text": [
      "送料として350円かかります\n",
      "送料込みの価格は460円です。\n"
     ]
    }
   ],
   "source": [
    "price = input(\"税抜き価格を入力してください：\")\n",
    "if price.isdigit() == True:\n",
    "    tprice = int(round((int(price) * 1.1),0))\n",
    "    if tprice >= 2000:\n",
    "        print(\"送料は無料です\")\n",
    "    else:\n",
    "        print(\"送料として350円かかります\")\n",
    "        tprice += 350\n",
    "    print(f\"送料込みの価格は{tprice}円です。\")\n",
    "else:\n",
    "    print(\"整数を入力してください\")"
   ]
  }
 ],

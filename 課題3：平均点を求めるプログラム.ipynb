     "text": [
      "5人のテストの平均点は73.400000点です\n"
     ]
    }
   ],
   "source": [
    "cnt=0\n",
    "sum=0\n",
    "while True:\n",
    "    point = int(input(\"点数を入力してください：\"))\n",
    "    if point != -1:\n",
    "        cnt += 1\n",
    "        sum += point\n",
    "    else:\n",
    "        break\n",
    "print(f\"5人のテストの平均点は{round(sum/cnt,2):.1f}点です\")"
   ]
  }
 ],
